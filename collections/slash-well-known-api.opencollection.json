{
  "opencollection": "1.0.0",
  "info": {
    "name": "Slash Public Account .well Known API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": ".well Known",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /.well-known/openid-configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/.well-known/openid-configuration"
          },
          "docs": "Get OpenID Configuration"
        }
      ]
    }
  ],
  "bundled": true
}