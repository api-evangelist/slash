{
  "opencollection": "1.0.0",
  "info": {
    "name": "Slash Public Account API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/account",
            "params": [
              {
                "name": "filter:legalEntityId",
                "value": "",
                "type": "query",
                "description": "Pass in a legal entity ID to filter for accounts under a specific legal entity."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List all accounts you have access to"
        },
        {
          "info": {
            "name": "GET /account/{accountId}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/account/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get a single account by Id"
        },
        {
          "info": {
            "name": "GET /account/{accountId}/balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/account/:accountId/balance",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a list of balances for an account. \nThe balances are returned in an array, with each item representing a balance for that account.\n\nFor charge_card accounts, there will be two balances returned: \"cash\" and \"credit\".\nFor debit accounts, there will only be one balance returned: \"debit\".\n"
        },
        {
          "info": {
            "name": "GET /account/{accountId}/authorization-webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/account/:accountId/authorization-webhook",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve the authorization webhook configuration for an account.\nThis webhook is called during card authorization requests to allow external systems\nto approve or reject transactions in real-time.\n"
        },
        {
          "info": {
            "name": "PUT /account/{accountId}/authorization-webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.slash.com/account/:accountId/authorization-webhook",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create or update the authorization webhook configuration for an account. This will upsert the webhook configuration, creating it if it doesn't exist or updating it if it does. \n\nThe secret for a webhook remains static after it is initially created. If you would like to retrieve the secret before sending requests,\ncreate the authorization webhook in status 'inactive' first and then update it to 'active' after.\n"
        },
        {
          "info": {
            "name": "PATCH /account/{accountId}/authorization-webhook",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.slash.com/account/:accountId/authorization-webhook",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Partially update the authorization webhook configuration for an account.\nOnly the provided fields will be updated.\n"
        }
      ]
    }
  ],
  "bundled": true
}