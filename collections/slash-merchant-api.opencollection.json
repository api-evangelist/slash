{
  "opencollection": "1.0.0",
  "info": {
    "name": "Slash Public Account Merchant API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Merchant",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /merchant",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/merchant",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "A cursor string to fetch the next page of results"
              },
              {
                "name": "search:merchant_name",
                "value": "",
                "type": "query",
                "description": "Pass in a merchant name to filter merchants by name."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve the list of available merchant ids"
        },
        {
          "info": {
            "name": "GET /merchant/{merchantId}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/merchant/:merchantId",
            "params": [
              {
                "name": "merchantId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Fetch details for a single merchant by ID"
        }
      ]
    }
  ],
  "bundled": true
}