              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Apply a partial update to a card's spending constraint while preserving current properties applied. Properties set to \"null\" will be removed from the spending constraint."
