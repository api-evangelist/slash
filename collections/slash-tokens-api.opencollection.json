{
  "opencollection": "1.0.0",
  "info": {
    "name": "Slash Public Account Tokens API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Token Prices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.slash.com/tokens/prices"
          },
          "docs": "Returns real-time prices for major crypto tokens. This endpoint is publicly accessible without authentication."
        }
      ]
    }
  ],
  "bundled": true
}