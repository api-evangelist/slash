        {
          "id": "3ac50f5c-0e6e-48e5-8a96-aa8dab3e1e7e",
          "name": "Get agent request",
          "request": {
            "name": "Get agent request",
            "description": {
              "content": "Get the status and details of an agent request by ID.\n\nAgent requests are created when a read-only API key makes a write request (POST, PUT, PATCH, DELETE) to the Public API. Instead of executing immediately, these requests are deferred and require approval from an authorized user.\n\nUse this endpoint to check the status of a pending request or retrieve the result after execution.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agent-request",
                ":agentRequestId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "agentRequestId",
                  "description": "(Required) The unique identifier of the agent request (returned in x-deferred-action-id header)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
