{
  "opencollection": "1.0.0",
  "info": {
    "name": "Slash Public Account Transfer API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfer",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "POST /transfer/virtual-account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.slash.com/transfer/virtual-account",
            "headers": [
              {
                "name": "X-Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Transfer money between Virtual Accounts or fund a Virtual Account from a Primary Account"
        }
      ]
    }
  ],
  "bundled": true
}